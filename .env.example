# Copy to .env (make env) and fill in. .env is git-ignored and never baked into images.

# ---------- LLM (required for the agents; tests and the backtest don't need it) ----------
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5        # default: $0.10 / $0.50 per 1M tokens
# LLM_MODEL=claude-sonnet-5-5       # harder questions: $2 / $10 per 1M tokens

# ---------- AWS CLI ----------
# The AWS CLI and boto3 use your normal credentials (~/.aws/credentials or SSO).
# Name the profile here so `make`, Python and Terraform all use the same one.
# AWS_PROFILE=default
AWS_REGION=ap-south-1
# S3_BUCKET=                        # `make infra-output` shows it after terraform apply
# CLOUDWATCH_ENABLED=false          # true = also send app metrics to CloudWatch from your laptop

# ---------- data ----------
# Folder with the CSV files (file name = table name). Relative to this project.
CSV_DIR=data/raw
# Business data. SQLite file by default; for RDS: postgresql://user:pass@host:5432/insightly
# DATABASE_URL=sqlite:///data/shop.db
# Chat memory. SQLite file by default; on EKS it is the RDS database.
# MEMORY_URL=sqlite:///data/memory.db
